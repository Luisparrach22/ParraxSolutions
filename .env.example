# Copia este archivo a .env.local y rellena los valores.

# URL pública del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://parraxsolutions.com

# Enlace de reserva (Cal.com / Calendly). Si se define, sustituye el placeholder del bloque de contacto.
NEXT_PUBLIC_CALENDAR_URL=

# Envío de emails del formulario de contacto vía Resend (https://resend.com)
# Sin estas dos variables, las solicitudes solo se registran en el log del servidor.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hola@parraxsolutions.com
# Remitente verificado en Resend (opcional; por defecto onboarding@resend.dev)
CONTACT_FROM_EMAIL=Parrax Web <web@parraxsolutions.com>
